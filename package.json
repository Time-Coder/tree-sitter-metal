{
  "name": "tree-sitter-metal",
  "version": "0.1.0",
  "description": "Metal Shading Language grammar for tree-sitter",
  "repository": "https://github.com/save-buffer/tree-sitter-metal",
  "license": "MIT",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "metal",
    "msl"
  ],
  "main": "bindings/node",
  "types": "bindings/node",
  "files": [
    "grammar.js",
    "binding.gyp",
    "bindings/node/*",
    "queries/*",
    "src/**"
  ],
  "dependencies": {
    "tree-sitter-cpp": "^0.23.4"
  },
  "peerDependencies": {
    "tree-sitter": "^0.21.0"
  },
  "peerDependenciesMeta": {
    "tree_sitter": {
      "optional": true
    }
  },
  "tree-sitter": [
    {
      "scope": "source.metal",
      "injection-regex": "^metal$"
    }
  ]
}
